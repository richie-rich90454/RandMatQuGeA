{
    "identifier": "default",
    "description": "Default capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:path:default",
        "core:window:allow-set-theme",
        "core:window:allow-set-effects",
        "updater:default",
        "updater:allow-check",
        "process:default"
    ]
}