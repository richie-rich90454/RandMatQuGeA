{
    "identifier": "default",
    "description": "Default capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:path:default",
        "core:window:allow-set-theme",
        "core:window:allow-theme",
        "core:window:allow-set-effects",
        "core:event:allow-listen",
        "updater:default",
        "updater:allow-check",
        "process:default",
        "dialog:default",
        "dialog:allow-save",
        "dialog:allow-open"
    ]
}