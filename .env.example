# Tauri v2 signing private key (generatable via npx tauri signer generate)
# Used to sign your application bundle. Can be either the plain private key string
# or a path to a private key file.
TAURI_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_GOES_HERE_WITHOUT_LINE_BREAKS_AND_WITHOUT_EXTRA_SPACES
-----END PRIVATE KEY-----

# (Optional) Password for the signing private key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=your_private_key_password_if_any