root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
indent_style = tab
indent_size = 4

[*.css]
indent_style = tab
indent_size = 4

[*.html]
indent_style = tab
indent_size = 4

[*.json]
indent_style = tab
indent_size = 4

[*.rs]
indent_style = tab
indent_size = 4

[*.md]
indent_style = tab
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2
