# --- Ensure Go and Rust are detected ---
*.go linguist-language=Go
*.go linguist-detectable=true

*.rs linguist-language=Rust
*.rs linguist-detectable=true

# Ensure Rust inside Tauri is counted
src-tauri/**/*.rs linguist-language=Rust
src-tauri/**/*.rs linguist-detectable=true

# --- Ignore generated build output ---
dist/** linguist-generated=true
target/** linguist-generated=true

# --- Ignore dependency folders ---
node_modules/** linguist-generated=true

# --- Ignore lockfiles (dependency metadata) ---
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true

# --- Ignore common config / metadata that skews stats ---
*.toml linguist-generated=true
*.json linguist-generated=true
*.lock linguist-generated=true

# --- Documentation ---
*.md linguist-documentation=true
